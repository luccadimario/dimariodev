{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "dimariodev",
    "main": ".open-next/worker.js",
    "compatibility_date": "2026-09-02",
    // nodejs_compat is required by the OpenNext adapter; the _v2 flag opts
    // into Workers' current global-scope behaviour for Node built-ins.
    "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "observability": {
        "enabled": true
    }
}
